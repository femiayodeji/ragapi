# ===================================
# RAG Application Configuration
# ===================================
# Copy this file to .env and fill in your values
# Minimal required: LLM_PROVIDER, LLM_MODEL, LLM_API_KEY, EMBEDDING_PROVIDER, EMBEDDING_MODEL, EMBEDDING_API_KEY

# ===================================
# LLM Provider Configuration
# ===================================
# Options: groq, openai, gemini, anthropic, ollama
# Recommended for beginners: groq (fast, free tier)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your-groq-api-key-here
LLM_BASE_URL=
LLM_TEMPERATURE=0.3

# Provider-specific model examples:
# groq: llama-3.3-70b-versatile, mixtral-8x7b-32768
# openai: gpt-4-turbo-preview, gpt-3.5-turbo
# gemini: gemini-1.5-flash, gemini-1.5-pro
# anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229
# ollama: llama3.1, mistral (requires local Ollama installation)

# ===================================
# Embedding Provider Configuration
# ===================================
# Options: jinaai, openai, gemini, ollama
# Recommended for beginners: jinaai (free tier, no credit card)
EMBEDDING_PROVIDER=jinaai
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_API_KEY=your-jina-api-key-here
EMBEDDING_BASE_URL=

# Provider-specific model examples:
# jinaai: jina-embeddings-v3
# openai: text-embedding-3-small, text-embedding-3-large
# gemini: text-embedding-004
# ollama: nomic-embed-text, mxbai-embed-large (requires local Ollama)

# Provider-specific model examples:
# jinaai: jina-embeddings-v3
# openai: text-embedding-3-small, text-embedding-3-large
# gemini: text-embedding-004
# ollama: nomic-embed-text, mxbai-embed-large (requires local Ollama)

# ===================================
# Document Processing Settings
# ===================================
# CHUNK_SIZE: Characters per document chunk (smaller = more precise, more chunks)
# CHUNK_OVERLAP: Overlap between chunks to maintain context
# TOP_K: Number of most relevant chunks to retrieve for each query
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=3

# ===================================
# Voice Settings
# ===================================
# WHISPER_MODEL options: tiny, base, small, medium, large
# (larger models = better accuracy but slower and more memory)
WHISPER_MODEL=base

# ===================================
# Redis Configuration (Optional)
# ===================================
# Redis enables persistent sessions and rate limiting
# Leave defaults if using Docker Compose or local Redis
# Set SESSION_BACKEND=memory if Redis is unavailable
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===================================
# Session Management
# ===================================
# SESSION_BACKEND: redis (requires Redis) or memory (fallback, no persistence)
# SESSION_EXPIRE: Session timeout in seconds (3600 = 1 hour)
# SESSION_MAX_HISTORY: Maximum conversation messages stored per session
SESSION_BACKEND=redis
SESSION_EXPIRE=3600
SESSION_MAX_HISTORY=10
SESSION_KEY_PREFIX=session:

# ===================================
# Server Configuration
# ===================================
# SERVER_HOST: 0.0.0.0 allows external access, 127.0.0.1 is local only
# SERVER_PORT: Port for the web server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ===================================
# Getting API Keys (All Free Tiers Available)
# ===================================
# Groq: https://console.groq.com/keys (Fast, generous free tier)
# Jina AI: https://jina.ai/embeddings (Free, no credit card)
# Gemini: https://ai.google.dev/ (Free tier available)
# OpenAI: https://platform.openai.com/api-keys (Requires payment)
# Anthropic: https://console.anthropic.com/ (Requires payment)
# Ollama: https://ollama.ai/ (Free, runs locally - no API key needed)
